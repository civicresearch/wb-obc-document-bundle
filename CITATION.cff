type: dataset
title: "West Bengal OBC Archive: Documents, notifications and litigation on Other Backward Classes reservation in West Bengal, 1993–2026"
authors:
  - name: "Civic Research Group"
    website: "https://civicresearch.in"
    email: "civicresearchgroup@gmail.com"
url: "https://obcwb.civicresearch.in"
repository-code: "https://github.com/civicresearch/wb-obc-document-bundle"
